# --------------------------------------------------------------------------
# control vocabulary
# --------------------------------------------------------------------------

BUTTONS = {
    "A": e.BTN_A, "B": e.BTN_B, "X": e.BTN_X, "Y": e.BTN_Y,
    "LB": e.BTN_TL, "RB": e.BTN_TR,
    "BACK": e.BTN_SELECT, "START": e.BTN_START, "GUIDE": e.BTN_MODE,
    "LS": e.BTN_THUMBL, "RS": e.BTN_THUMBR,
}
HAT = {"UP": (e.ABS_HAT0Y, -1), "DOWN": (e.ABS_HAT0Y, 1),
       "LEFT": (e.ABS_HAT0X, -1), "RIGHT": (e.ABS_HAT0X, 1)}
TRIGGERS = {"LT": e.ABS_Z, "RT": e.ABS_RZ}
STICKS = {"L": (e.ABS_X, e.ABS_Y), "R": (e.ABS_RX, e.ABS_RY)}
DIRS = {"U": "UP", "D": "DOWN", "L": "LEFT", "R": "RIGHT",
        "\u2191": "UP", "\u2193": "DOWN", "\u2190": "LEFT", "\u2192": "RIGHT"}

# The kernel xpad driver's capability set, in its order, so the joydev
# axis/button numbering matches a real Xbox 360 pad exactly:
#   axes    0 LX  1 LY  2 LT  3 RX  4 RY  5 RT  6 DpadX  7 DpadY
#   buttons 0 A   1 B   2 X   3 Y   4 LB  5 RB  6 Back  7 Start  8 Guide  9 LS  10 RS
_STICK = AbsInfo(value=0, min=-32768, max=32767, fuzz=16, flat=128, resolution=0)
_TRIG = AbsInfo(value=0, min=0, max=255, fuzz=0, flat=0, resolution=0)
_HAT = AbsInfo(value=0, min=-1, max=1, fuzz=0, flat=0, resolution=0)

CAPS = {
    e.EV_KEY: list(BUTTONS.values()),
    e.EV_ABS: [(e.ABS_X, _STICK), (e.ABS_Y, _STICK), (e.ABS_Z, _TRIG),
               (e.ABS_RX, _STICK), (e.ABS_RY, _STICK), (e.ABS_RZ, _TRIG),
               (e.ABS_HAT0X, _HAT), (e.ABS_HAT0Y, _HAT)],
}
TARGET_ABS = dict(CAPS[e.EV_ABS])

# Names usable in [passthrough] invert / remap. Targets are the virtual Xbox
# pad's controls; remap sources are the real pad's evdev axes (no ABS_ prefix).
AXIS_TARGETS = {"LX": e.ABS_X, "LY": e.ABS_Y, "RX": e.ABS_RX, "RY": e.ABS_RY,
                "LT": e.ABS_Z, "RT": e.ABS_RZ,
                "DPADX": e.ABS_HAT0X, "DPADY": e.ABS_HAT0Y}
AXIS_SOURCES = {n: getattr(e, "ABS_" + n) for n in
                ("X", "Y", "Z", "RX", "RY", "RZ", "HAT0X", "HAT0Y")}


def js_node_for(evdev_path: str) -> str | None:
    """/dev/input/event26 -> /dev/input/js1 (same underlying input device)."""
    sysdir = Path("/sys/class/input") / Path(evdev_path).name / "device"
    for child in sorted(sysdir.glob("js*")) if sysdir.exists() else []:
        return f"/dev/input/{child.name}"
    return None


def device_name(js_path: str) -> str:
    p = Path("/sys/class/input") / Path(js_path).name / "device" / "name"
    return p.read_text().strip() if p.exists() else "?"


