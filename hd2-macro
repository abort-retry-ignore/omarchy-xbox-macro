# --------------------------------------------------------------------------

class HyprFocus:
    """Tracks the focused window via Hyprland's event socket, so ordinary keys
    like 1 and 2 can be used as hotkeys without hijacking them system-wide."""

    def __init__(self, cfg, log=print):
        self.match = [m.lower() for m in cfg.get("focus", {}).get("only_when", [])]
        self.log = log
        self.sock = None
        self.buf = b""
        self.cls = ""
        self.title = ""

    @property
    def gating(self) -> bool:
        return bool(self.match)

    def connect(self):
        his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not self.gating or not his:
            return None
        path = RUNDIR / "hypr" / his / ".socket2.sock"
        if not path.exists():
            self.log(f"focus gate: no {path}, macros will fire regardless of focus")
            self.match = []
            return None
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(str(path))
        s.setblocking(False)
        self.sock = s
        self.seed()
        self.log(f"focus gate: only when window matches {self.match}")
        return s

    def seed(self):
        try:
            out = subprocess.run(["hyprctl", "activewindow", "-j"],
                                 capture_output=True, text=True, timeout=2).stdout
            d = json.loads(out)
            self.cls, self.title = d.get("class", ""), d.get("title", "")
        except Exception:
            pass

    def pump(self, sock) -> bool:
        try:
            data = sock.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            return False
        if not data:
            return False
        self.buf += data
        while b"\n" in self.buf:
            line, _, self.buf = self.buf.partition(b"\n")
            ev, _, payload = line.decode("utf-8", "replace").partition(">>")
            if ev == "activewindow":
                self.cls, _, self.title = payload.partition(",")
        return True

    @property
    def allowed(self) -> bool:
        if not self.match:
            return True
        hay = f"{self.cls} {self.title}".lower()
        return any(m in hay for m in self.match)

    def close(self):
        if self.sock:
            self.sock.close()
            self.sock = None


