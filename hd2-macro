def read_config(path: Path = CONFIG) -> dict:
    """Parse the config, raising on any problem. Used by the live reloader."""
    with path.open("rb") as fh:
        return tomllib.load(fh)


def load_config(path: Path = CONFIG) -> dict:
    if not path.exists():
        sys.exit(f"no config at {path}\nrun:  {APP} install")
    return read_config(path)


def talk(line: str, quiet=False) -> str | None:
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(3)
            s.connect(str(SOCKET))
            s.sendall(line.encode())
            return s.recv(4096).decode().strip()
    except (FileNotFoundError, ConnectionRefusedError, socket.timeout, OSError):
        if not quiet:
            print(f"{APP} is not running  ({APP} on)", file=sys.stderr)
        return None


def systemctl(*args) -> int:
    return subprocess.call(["systemctl", "--user", *args])


UNIT = """[Unit]
Description=hd2-macro virtual gamepad daemon
After=graphical-session.target

[Service]
Type=simple
ExecStart={exe} daemon
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=graphical-session.target
"""

RULE = """# Installed by hd2-macro ({app} hide). Hides these gamepads' joydev nodes
# from browsers so Xbox Cloud Gaming only sees the virtual pad. The evdev node
# stays accessible so hd2-macro can grab and forward the real controller.
# Remove with: {app} unhide
{lines}
"""


def gamepads() -> list[dict]:
    """Every gamepad on the system, with what a browser could actually open."""
    out = []
    for path in sorted(Path("/dev/input").glob("js*"), key=lambda p: p.name):
        sysdev = Path("/sys/class/input") / path.name / "device"
        read = lambda f: (sysdev / f).read_text().strip() if (sysdev / f).exists() else "?"
        ev = next((c.name for c in sorted(sysdev.glob("event*"))), None)
        out.append({
            "js": str(path),
            "name": read("name"),
            "vendor": read("id/vendor"),
            "product": read("id/product"),
            "event": f"/dev/input/{ev}" if ev else None,
            "browser_visible": os.access(path, os.R_OK),
            "virtual": "/devices/virtual/" in os.path.realpath(sysdev),
        })
    return out


def cmd_devices(args):
