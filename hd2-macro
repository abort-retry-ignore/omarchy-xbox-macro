def cmd_doctor(args):
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        ok = ok and good
        print(f"  [{'ok' if good else 'XX'}] {label}" + (f"  {detail}" if detail else ""))

    print("permissions")
    w = os.access("/dev/uinput", os.W_OK)
    check("/dev/uinput writable", w, "" if w else f"-> {APP} grant  (installs a uaccess rule)")
    joydev = b"joydev" in subprocess.run(["lsmod"], capture_output=True).stdout
    check("joydev module loaded", joydev, "" if joydev else "-> sudo modprobe joydev")

    print("config")
    check(str(CONFIG), CONFIG.exists())
    cfg = {}
    if CONFIG.exists():
        cfg = load_config()
        hk = cfg.get("hotkeys", {})
        kb_keys = [k for k in hk if not k.lower().startswith("pad:")]
        # A mangled [hotkeys] header still parses as valid TOML, it just
        # lands the bindings in the previous table. Catch that here rather
        # than leaving the user with a daemon that does nothing.
        check("[hotkeys] has bindings", bool(hk),
              f"{len(hk)} bound" if hk else
              "-> no [hotkeys] table found; check the section header in the config")
        stray = [k for k in ("1", "2", "3", "toggle", "panic")
                 if k in cfg.get("passthrough", {}) or k in cfg.get("keyboards", {})]
        if stray:
            check("no misplaced hotkeys", False,
                  f"found {stray} under [passthrough]/[keyboards] -- a broken "
                  f"[hotkeys] header above them")
        try:
            for k in hk:
                padcode(k[4:]) if k.lower().startswith("pad:") else parse_hotkey(k)
            if hk:
                check("hotkey names valid", True, f"{len(hk)} bound")
        except KeyError as exc:
            check("hotkey names valid", False, str(exc))
        if kb_keys:
            kbs = find_keyboards(cfg.get("keyboards", {}).get("match", []), set())
            check("keyboards readable", bool(kbs),
                  ", ".join(d.name for d in kbs[:2]) if kbs else f"-> {APP} grant")
            for d in kbs:
                d.close()
        else:
            print("  [--] no keyboard hotkeys configured (using Hyprland binds?)")

    print("gamepads")
    pads = gamepads()
    for g in pads:
        kind = "virtual" if g["virtual"] else "physical"
        print(f"       {g['js']}  {kind:<9}{'VISIBLE' if g['browser_visible'] else 'hidden':<9}"
              f"{g['name']}")
    visible = [g for g in pads if g["browser_visible"]]
    check("browser sees exactly one gamepad", len(visible) <= 1,
          "none yet" if not visible else
          ("" if len(visible) == 1 else f"sees {len(visible)} -> run `{APP} hide`"))
    print(f"  [--] udev hide rule  "
          f"{'installed' if UDEV_RULE.exists() else 'not installed (only needed with a real pad)'}")

    print("daemon")
    st = talk("status", quiet=True)
    check("running", st is not None, st or f"-> {APP} on")
    print("\n" + ("all good" if ok else "see the problems above"))
    return 0 if ok else 1


def cmd_keys(args):
    """Live key identifier: press keys, get the name to put in [hotkeys]."""
    devs = find_keyboards([], set())
    pads = []
    for path in list_devices():
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        caps = dev.capabilities()
        if e.BTN_A in set(caps.get(e.EV_KEY, [])) and dev.path not in {d.path for d in devs}:
            pads.append(dev)
        else:
            dev.close()
    if not devs and not pads:
        print("no readable input devices\n"
              "  keyboards need:  sudo usermod -aG input $USER   (then log out and in)")
        return 1
    for d in devs:
        print(f"watching keyboard  {d.name}")
    for d in pads:
        print(f"watching gamepad   {d.name}")
    if talk("status", quiet=True) and pads:
        print("note: the daemon holds a grab on the controller; stop it to see pad buttons")
    print("\npress keys (ctrl-c to stop)\n")
    sel = selectors.DefaultSelector()
    for d in devs + pads:
        sel.register(d, selectors.EVENT_READ, d in pads)
    seen, mods = [], set()
    try:
        while True:
            for key, _ in sel.select(timeout=1.0):
                try:
                    events = list(key.fileobj.read())
                except OSError:
                    continue
                for ev in events:
                    if ev.type != e.EV_KEY:
                        continue
                    if not key.data and ev.code in MOD_BY_CODE:
                        mods.add(ev.code) if ev.value else mods.discard(ev.code)
                        continue
                    if ev.value != 1:
                        continue
                    if key.data:  # gamepad
                        name = next((n for n, c in BUTTONS.items() if c == ev.code), None)
                        raw = e.BTN.get(ev.code) or e.KEY.get(ev.code) or ev.code
                        raw = raw[0] if isinstance(raw, list) else raw
                        stem = str(raw).removeprefix("KEY_").removeprefix("BTN_")
                        label = f'"pad:{name or stem}"'
                    else:
                        label = show_hotkey(ev.code, frozenset(MOD_BY_CODE[c] for c in mods))
                        if not re.fullmatch(r"[A-Za-z0-9_]+", label):
                            label = f'"{label}"'
                    if label not in seen:
                        seen.append(label)
                        print(f"  {label:<20} # code {ev.code}")
    except KeyboardInterrupt:
        pass
    finally:
        for d in devs + pads:
            d.close()
    if seen:
        print(f"\nput these in [hotkeys] in {CONFIG}, e.g.")
        print(f'  {seen[0]} = "reinforce"')
    return 0


def cmd_list(args):
    cfg = load_config()
    print("hotkeys")
    for k, v in cfg.get("hotkeys", {}).items():
        print(f"  {k:<14} {v}")
    print("\nstratagems")
    for k, v in sorted(cfg.get("stratagems", {}).items()):
        print(f"  {k:<28} {v}")
    print("\nmacros")
    for k in sorted(cfg.get("macros", {})):
        print(f"  {k}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog=APP, description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name, help_ in [
        ("daemon", "run the daemon in the foreground"),
        ("on", "start the daemon service"),
        ("off", "stop the daemon service"),
        ("toggle", "start/stop the daemon service"),
        ("status", "show daemon status"),
        ("arm", "enable hotkeys"),
        ("disarm", "ignore hotkeys, keep the pad connected"),
        ("panic", "release every button immediately"),
        ("wake", "nudge the pad so the browser exposes it to the page"),
        ("list", "list hotkeys, stratagems and macros"),
        ("reload", "re-read the config now, without restarting"),
        ("keys", "press keys to learn their [hotkeys] names"),
        ("devices", "list gamepads and what the browser sees"),
        ("unhide", "remove the udev rule installed by `hide`"),
        ("grant", "let this session read keyboards, for keyboard hotkeys"),
        ("revoke", "remove the udev rule installed by `grant`"),
        ("doctor", "diagnose the setup"),
    ]:
        sub.add_parser(name, help=help_)
    r = sub.add_parser("run", help="fire a macro or stratagem now")
    r.add_argument("name")
    r.add_argument("--speed", type=float, metavar="X",
                   help="scale every duration for this run (0.5 = half speed)")
    r.add_argument("--pre", type=float, metavar="MS",
                   help="stratagem pre_ms: menu-open settle, before the first direction")
    r.add_argument("--post", type=float, metavar="MS",
                   help="stratagem post_ms: hold time after the last direction")
    r.add_argument("--press", type=float, metavar="MS", help="press_ms for this run")
    r.add_argument("--gap", type=float, metavar="MS", help="gap_ms for this run")
    r.add_argument("--throw", metavar="BTN",
                   help="throw the beacon with this button, e.g. RT ('' to disable)")
    h = sub.add_parser("hide", help="keep a physical pad out of the browser's gamepad list")
    h.add_argument("device", nargs="?", help="name fragment or vid:pid (default: all physical)")
    h.add_argument("--all", action="store_true")
    i = sub.add_parser("install", help="install config, symlink and systemd unit")
    i.add_argument("--force", action="store_true", help="overwrite an existing config")

    args = ap.parse_args()
    c = args.cmd
    if c == "daemon":
        Daemon(load_config()).serve()
        return 0
    if c in ("install", "doctor", "list", "keys", "devices", "hide", "unhide",
             "grant", "revoke"):
        return globals()[f"cmd_{c}"](args)
    if c == "on":
        return systemctl("start", f"{APP}.service")
    if c == "off":
        return systemctl("stop", f"{APP}.service")
    if c == "toggle":
        active = subprocess.run(["systemctl", "--user", "is-active", "--quiet",
                                 f"{APP}.service"]).returncode == 0
        return systemctl("stop" if active else "start", f"{APP}.service")
    if c == "status":
        print(talk("status", quiet=True) or "stopped")
        return 0
    if c == "run":
        over = {k: v for k, v in (
            ("speed", args.speed), ("pre_ms", args.pre), ("post_ms", args.post),
            ("press_ms", args.press), ("gap_ms", args.gap),
            ("throw_button", args.throw)) if v is not None}
        qs = "&".join(f"{k}={v}" for k, v in over.items())
        reply = talk(f"run {args.name}" + (f"?{qs}" if qs else ""))
    else:
        reply = talk(c)
    if reply is None:
        return 1
    print(reply)
    return 0 if reply.startswith("ok") else 1


if __name__ == "__main__":
    sys.exit(main() or 0)
