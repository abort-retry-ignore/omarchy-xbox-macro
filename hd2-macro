            print(f"  - run `{APP} hide` to keep its node out of the browser's list")
    return 0


GRANT_RULE = """# Installed by hd2-macro ({app} grant).
#
# 1. /dev/uinput: needed to create the virtual pad. Some systems get this
#    for free because Steam or logitech-udev-rules ship the same rule, but
#    a clean machine has no rule at all and the node stays root-only.
# 2. keyboard event nodes: needed for keyboard hotkeys. udev already does
#    this for joysticks (70-uaccess.rules); this extends it to keyboards
#    without putting the user in the `input` group.
#
# uaccess grants an ACL only to whoever is physically logged in at the
# seat, and it is dropped on logout. Remove with: {app} revoke
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
SUBSYSTEM=="input", KERNEL=="event*", ENV{{ID_INPUT_KEYBOARD}}=="?*", TAG+="uaccess"
SUBSYSTEM=="input", KERNEL=="event*", ENV{{ID_INPUT_KEY}}=="?*", TAG+="uaccess"
"""


def _reload_udev():
    subprocess.call(["sudo", "udevadm", "control", "--reload"])
    subprocess.call(["sudo", "udevadm", "trigger", "--subsystem-match=input",
                     "--action=change"])
    subprocess.call(["sudo", "udevadm", "trigger", "--subsystem-match=misc",
                     "--action=change"])
    subprocess.call(["sudo", "udevadm", "settle"])


def cmd_grant(args):
    text = GRANT_RULE.format(app=APP)
    print(f"installing {UDEV_GRANT}:\n")
    print(text)
    rc = subprocess.run(["sudo", "tee", str(UDEV_GRANT)],
                        input=text.encode(), stdout=subprocess.DEVNULL).returncode
    if rc:
        return rc
    subprocess.call(["sudo", "modprobe", "uinput"])
    _reload_udev()
    ok = True
    if os.access("/dev/uinput", os.W_OK):
        print("/dev/uinput is writable")
    else:
        ok = False
        print("/dev/uinput still NOT writable -- are you logged in locally at the seat?\n"
              "   an ssh-only session gets no uaccess ACL; log in at the machine,\n"
              "   or add yourself to a group that owns the node")
    kbs = find_keyboards([], set())
    if kbs:
        print(f"keyboards readable: {', '.join(d.name for d in kbs[:4])}")
        for d in kbs:
            d.close()
    else:
        ok = False
        print("no keyboards readable -- `sudo usermod -aG input $USER` and re-login")
    print(f"\nrestart the daemon to pick this up:  {APP} off && {APP} on")
    return 0 if ok else 1


def cmd_revoke(args):
    if not UDEV_GRANT.exists():
        print("nothing to revoke")
        return 0
    subprocess.call(["sudo", "rm", "-f", str(UDEV_GRANT)])
    _reload_udev()
    print(f"removed {UDEV_GRANT}")
    return 0


def cmd_hide(args):
    pads = [g for g in gamepads() if not g["virtual"]]
    if args.all:
        targets = pads
    elif args.device:
        targets = [g for g in pads
                   if args.device.lower() in g["name"].lower()
                   or args.device.lower() == f"{g['vendor']}:{g['product']}"]
    else:
        targets = pads
    if not targets:
        print("no physical gamepads matched")
        return 1
    lines = "\n".join(
        f'SUBSYSTEM=="input", KERNEL=="js[0-9]*", ATTRS{{id/vendor}}=="{g["vendor"]}", '
        f'ATTRS{{id/product}}=="{g["product"]}", TAG-="uaccess", '
        f'MODE="0600", OWNER="root", GROUP="root"'
        for g in targets)
    text = RULE.format(app=APP, lines=lines)
    print(f"installing {UDEV_RULE}:\n")
    print(text)
    for g in targets:
        print(f"  hiding {g['name']} ({g['vendor']}:{g['product']})")
    rc = subprocess.run(["sudo", "tee", str(UDEV_RULE)],
                        input=text.encode(), stdout=subprocess.DEVNULL).returncode
    if rc:
        return rc
    _reload_udev()
    print(f"\ndone. verify with `{APP} devices`; undo with `{APP} unhide`")
    return 0


def cmd_unhide(args):
    if not UDEV_RULE.exists():
        print("nothing to undo")
        return 0
    subprocess.call(["sudo", "rm", "-f", str(UDEV_RULE)])
    _reload_udev()
    print(f"removed {UDEV_RULE}")
    return 0


