# virtual pad
# --------------------------------------------------------------------------

class Pad:
    """The virtual pad. Merges two input layers:

    phys  - forwarded from a real controller (passthrough)
    macro - asserted by a running macro; overrides phys while held

    Releasing a macro control falls back to whatever the real pad is doing,
    so a macro never eats a button you are physically holding.
    """

    def __init__(self, cfg):
        p = cfg.get("pad", {})
        self.ui = UInput(
            CAPS,
            name=p.get("name", "Microsoft X-Box 360 pad"),
            vendor=p.get("vendor", 0x045E),
            product=p.get("product", 0x028E),
            version=p.get("version", 0x0114),
            bustype=p.get("bustype", 3),
        )
        self.lock = threading.RLock()
        # control -> {source pad path: last value}; see _phys()
        self.phys: dict[tuple[int, int], dict[str, int]] = {}
        self.macro: dict[tuple[int, int], int] = {}
        self.sent: dict[tuple[int, int], int] = {}

    @property
    def path(self) -> str:
        return self.ui.device.path

    @property
    def js(self) -> str | None:
        return js_node_for(self.path)

    # ---- emission -------------------------------------------------------
    def _flush(self, keys):
        changed = False
        for k in keys:
            value = self.macro.get(k, self._phys(k))
            if self.sent.get(k, 0) != value:
                self.sent[k] = value
                self.ui.write(k[0], k[1], value)
                changed = True
        if changed:
            self.ui.syn()

    def _keys_for(self, name: str) -> list[tuple[tuple[int, int], int]]:
        """Resolve a control name to [(key, asserted_value), ...]."""
        n = name.upper()
        if n in BUTTONS:
            return [((e.EV_KEY, BUTTONS[n]), 1)]
        if n in HAT:
            axis, val = HAT[n]
            return [((e.EV_ABS, axis), val)]
        if n in TRIGGERS:
            return [((e.EV_ABS, TRIGGERS[n]), 255)]
        raise KeyError(f"unknown control {name!r}")

    # ---- macro layer ----------------------------------------------------
    def set(self, name: str, on: bool):
        with self.lock:
            keys = self._keys_for(name)
            for k, v in keys:
                if on:
                    self.macro[k] = v
                else:
                    self.macro.pop(k, None)
            self._flush([k for k, _ in keys])

    def axis(self, name: str, value: int):
        with self.lock:
            k = (e.EV_ABS, TRIGGERS[name.upper()])
            self.macro[k] = max(0, min(255, int(value)))
            self._flush([k])

    def stick(self, which: str, x: float, y: float):
        ax, ay = STICKS[which.upper()]
        clamp = lambda v: max(-32768, min(32767, int(v * 32767)))
        with self.lock:
            self.macro[(e.EV_ABS, ax)] = clamp(x)
            self.macro[(e.EV_ABS, ay)] = clamp(y)
            self._flush([(e.EV_ABS, ax), (e.EV_ABS, ay)])

    def clear_macro(self):
        """Drop every macro assertion; real controller input keeps flowing."""
        with self.lock:
            keys = list(self.macro)
            self.macro.clear()
            self._flush(keys)

    # ---- passthrough layer ----------------------------------------------
    def _phys(self, k) -> int:
        """Physical value of a control across every attached pad. The largest
        deflection wins, so a pad resting at centre never cancels another
        pad that is in use, and a button stays down while either holds it."""
        vals = self.phys.get(k)
        return max(vals.values(), key=abs) if vals else 0

    def feed(self, etype: int, code: int, value: int, src: str = ""):
        with self.lock:
            k = (etype, code)
            self.phys.setdefault(k, {})[src] = value
            self._flush([k])

    def feed_axes(self, values: dict[int, int], src: str):
        """Apply one raw report atomically (including diagonal D-pad input)."""
        with self.lock:
            keys = []
            for code, value in values.items():
                k = (e.EV_ABS, code)
                self.phys.setdefault(k, {})[src] = value
                keys.append(k)
            self._flush(keys)

    def drop(self, src: str):
        """Forget everything one pad was holding (it disconnected), so its
        last button/stick state can never stick on the virtual pad."""
        with self.lock:
            keys = []
            for k, vals in list(self.phys.items()):
                if vals.pop(src, None) is not None:
                    keys.append(k)
                if not vals:
                    del self.phys[k]
            self._flush(keys)

    def close(self):
        try:
            with self.lock:
                self.macro.clear()
                self.phys.clear()
                self._flush(list(self.sent))
            self.ui.close()
        except Exception:
            pass


