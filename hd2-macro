# --------------------------------------------------------------------------
# control vocabulary
# --------------------------------------------------------------------------

BUTTONS = {
    "A": e.BTN_A, "B": e.BTN_B, "X": e.BTN_X, "Y": e.BTN_Y,
    "LB": e.BTN_TL, "RB": e.BTN_TR,
    "BACK": e.BTN_SELECT, "START": e.BTN_START, "GUIDE": e.BTN_MODE,
    "LS": e.BTN_THUMBL, "RS": e.BTN_THUMBR,
}
HAT = {"UP": (e.ABS_HAT0Y, -1), "DOWN": (e.ABS_HAT0Y, 1),
       "LEFT": (e.ABS_HAT0X, -1), "RIGHT": (e.ABS_HAT0X, 1)}
TRIGGERS = {"LT": e.ABS_Z, "RT": e.ABS_RZ}
STICKS = {"L": (e.ABS_X, e.ABS_Y), "R": (e.ABS_RX, e.ABS_RY)}
DIRS = {"U": "UP", "D": "DOWN", "L": "LEFT", "R": "RIGHT",
        "\u2191": "UP", "\u2193": "DOWN", "\u2190": "LEFT", "\u2192": "RIGHT"}

# The kernel xpad driver's capability set, in its order, so the joydev
# axis/button numbering matches a real Xbox 360 pad exactly:
#   axes    0 LX  1 LY  2 LT  3 RX  4 RY  5 RT  6 DpadX  7 DpadY
#   buttons 0 A   1 B   2 X   3 Y   4 LB  5 RB  6 Back  7 Start  8 Guide  9 LS  10 RS
_STICK = AbsInfo(value=0, min=-32768, max=32767, fuzz=16, flat=128, resolution=0)
_TRIG = AbsInfo(value=0, min=0, max=255, fuzz=0, flat=0, resolution=0)
_HAT = AbsInfo(value=0, min=-1, max=1, fuzz=0, flat=0, resolution=0)

CAPS = {
    e.EV_KEY: list(BUTTONS.values()),
    e.EV_ABS: [(e.ABS_X, _STICK), (e.ABS_Y, _STICK), (e.ABS_Z, _TRIG),
               (e.ABS_RX, _STICK), (e.ABS_RY, _STICK), (e.ABS_RZ, _TRIG),
               (e.ABS_HAT0X, _HAT), (e.ABS_HAT0Y, _HAT)],
}
TARGET_ABS = dict(CAPS[e.EV_ABS])


def js_node_for(evdev_path: str) -> str | None:
    """/dev/input/event26 -> /dev/input/js1 (same underlying input device)."""
    sysdir = Path("/sys/class/input") / Path(evdev_path).name / "device"
    for child in sorted(sysdir.glob("js*")) if sysdir.exists() else []:
        return f"/dev/input/{child.name}"
    return None


def device_name(js_path: str) -> str:
    p = Path("/sys/class/input") / Path(js_path).name / "device" / "name"
    return p.read_text().strip() if p.exists() else "?"


# --------------------------------------------------------------------------
# virtual pad
# --------------------------------------------------------------------------

class Pad:
    """The virtual pad. Merges two input layers:

    phys  - forwarded from a real controller (passthrough)
    macro - asserted by a running macro; overrides phys while held

    Releasing a macro control falls back to whatever the real pad is doing,
    so a macro never eats a button you are physically holding.
    """

    def __init__(self, cfg):
        p = cfg.get("pad", {})
        self.ui = UInput(
            CAPS,
            name=p.get("name", "Microsoft X-Box 360 pad"),
            vendor=p.get("vendor", 0x045E),
            product=p.get("product", 0x028E),
            version=p.get("version", 0x0114),
            bustype=p.get("bustype", 3),
        )
        self.lock = threading.RLock()
        self.phys: dict[tuple[int, int], int] = {}
        self.macro: dict[tuple[int, int], int] = {}
        self.sent: dict[tuple[int, int], int] = {}

    @property
    def path(self) -> str:
        return self.ui.device.path

    @property
    def js(self) -> str | None:
        return js_node_for(self.path)

    # ---- emission -------------------------------------------------------
    def _flush(self, keys):
        changed = False
        for k in keys:
            value = self.macro.get(k, self.phys.get(k, 0))
            if self.sent.get(k, 0) != value:
                self.sent[k] = value
                self.ui.write(k[0], k[1], value)
                changed = True
        if changed:
            self.ui.syn()

    def _keys_for(self, name: str) -> list[tuple[tuple[int, int], int]]:
        """Resolve a control name to [(key, asserted_value), ...]."""
        n = name.upper()
        if n in BUTTONS:
            return [((e.EV_KEY, BUTTONS[n]), 1)]
        if n in HAT:
            axis, val = HAT[n]
            return [((e.EV_ABS, axis), val)]
        if n in TRIGGERS:
            return [((e.EV_ABS, TRIGGERS[n]), 255)]
        raise KeyError(f"unknown control {name!r}")

    # ---- macro layer ----------------------------------------------------
    def set(self, name: str, on: bool):
        with self.lock:
            keys = self._keys_for(name)
            for k, v in keys:
                if on:
                    self.macro[k] = v
                else:
                    self.macro.pop(k, None)
            self._flush([k for k, _ in keys])

    def axis(self, name: str, value: int):
        with self.lock:
            k = (e.EV_ABS, TRIGGERS[name.upper()])
            self.macro[k] = max(0, min(255, int(value)))
            self._flush([k])

    def stick(self, which: str, x: float, y: float):
        ax, ay = STICKS[which.upper()]
        clamp = lambda v: max(-32768, min(32767, int(v * 32767)))
        with self.lock:
            self.macro[(e.EV_ABS, ax)] = clamp(x)
            self.macro[(e.EV_ABS, ay)] = clamp(y)
            self._flush([(e.EV_ABS, ax), (e.EV_ABS, ay)])

    def clear_macro(self):
        """Drop every macro assertion; real controller input keeps flowing."""
        with self.lock:
            keys = list(self.macro)
            self.macro.clear()
            self._flush(keys)

    # ---- passthrough layer ----------------------------------------------
    def feed(self, etype: int, code: int, value: int):
        with self.lock:
            k = (etype, code)
            self.phys[k] = value
            self._flush([k])

    def close(self):
        try:
            with self.lock:
                self.macro.clear()
                self.phys.clear()
                self._flush(list(self.sent))
            self.ui.close()
        except Exception:
            pass


# --------------------------------------------------------------------------
# passthrough: grab a real controller, merge it into the virtual pad
# --------------------------------------------------------------------------

class Passthrough:
    """EVIOCGRAB is device-wide in the kernel: while we hold the grab, the
    source pad's own jsN node emits nothing, so the browser cannot see it."""

    def __init__(self, pad: Pad, cfg, on_button=None, log=print):
        self.pad = pad
        self.cfg = cfg.get("passthrough", {})
        self.hotkeys: dict[int, str] = {}
        self.on_button = on_button
        self.log = log
        self.dev: InputDevice | None = None
        self.scale: dict[int, tuple[float, int, int]] = {}

    @property
    def enabled(self) -> bool:
        return bool(self.cfg.get("enabled", True))

    def candidates(self) -> list[InputDevice]:
        want = self.cfg.get("match", [])
        out = []
        for path in list_devices():
            if path == self.pad.path:
                continue
            try:
                dev = InputDevice(path)
            except OSError:
                continue
            caps = dev.capabilities()
            keys = set(caps.get(e.EV_KEY, []))
            axes = {c for c, _ in caps.get(e.EV_ABS, [])}
            is_pad = e.BTN_A in keys and {e.ABS_X, e.ABS_Y} <= axes
            ident = f"{dev.info.vendor:04x}:{dev.info.product:04x}"
            if is_pad and (not want or any(
                    m.lower() in dev.name.lower() or m.lower() == ident for m in want)):
                out.append(dev)
            else:
                dev.close()
        return out

    def attach(self) -> bool:
        if self.dev or not self.enabled:
            return False
        for dev in self.candidates():
            try:
                dev.grab()
            except OSError as exc:
                self.log(f"cannot grab {dev.name}: {exc}")
                dev.close()
                continue
            self.dev = dev
            self.scale = {}
            for code, ai in dev.capabilities().get(e.EV_ABS, []):
                tgt = TARGET_ABS.get(code)
                if not tgt:
                    continue
                span = (ai.max - ai.min) or 1
                self.scale[code] = ((tgt.max - tgt.min) / span, ai.min, tgt.min)
            self.log(f"passthrough: grabbed {dev.name} "
                     f"({dev.info.vendor:04x}:{dev.info.product:04x}) -> virtual pad")
            return True
        return False

    def detach(self):
        if self.dev:
            try:
                self.dev.ungrab()
            except Exception:
                pass
            self.dev.close()
            self.log(f"passthrough: released {self.dev.name}")
            self.dev = None

    def pump(self, dev):
        try:
            for ev in dev.read():
                if ev.type == e.EV_KEY:
                    if ev.code in self.hotkeys:
                        if ev.value == 1 and self.on_button:
                            self.on_button(self.hotkeys[ev.code])
                        continue  # consumed, never forwarded
                    if ev.code in BUTTONS.values():
                        self.pad.feed(e.EV_KEY, ev.code, 1 if ev.value else 0)
                elif ev.type == e.EV_ABS and ev.code in self.scale:
                    factor, src_min, tgt_min = self.scale[ev.code]
                    self.pad.feed(e.EV_ABS, ev.code,
                                  int(round((ev.value - src_min) * factor + tgt_min)))
        except OSError as exc:
            if exc.errno in (errno.ENODEV, errno.EBADF):
                return False
        return True


