MODIFIERS = {
    "SHIFT": (e.KEY_LEFTSHIFT, e.KEY_RIGHTSHIFT),
    "CTRL": (e.KEY_LEFTCTRL, e.KEY_RIGHTCTRL),
    "ALT": (e.KEY_LEFTALT, e.KEY_RIGHTALT),
    "SUPER": (e.KEY_LEFTMETA, e.KEY_RIGHTMETA),
}
MOD_ALIASES = {"CONTROL": "CTRL", "META": "SUPER", "WIN": "SUPER", "CMD": "SUPER",
               "MOD": "SUPER", "OPT": "ALT", "OPTION": "ALT", "ALTGR": "ALT"}
MOD_BY_CODE = {code: name for name, codes in MODIFIERS.items() for code in codes}


class Notifier:
    """Omarchy desktop notifications, falling back to plain notify-send.

    Reuses one notification id so arming/disarming updates a single toast
    instead of stacking a new one every time.
    """

    GLYPHS = {"armed": "\U000f05ba",      # nf-md-microsoft_xbox_controller
              "disarmed": "\U000f05bb",   # nf-md-microsoft_xbox_controller_off
              "panic": "\U000f073a"}      # nf-md-cancel

    def __init__(self, cfg, log=print):
        section = cfg.get("notify", True)
        if isinstance(section, dict):
            self.enabled = section.get("enabled", True)
            self.glyphs = {**self.GLYPHS, **section.get("glyphs", {})}
            self.timeout = int(section.get("timeout_ms", 1800))
        else:
            self.enabled = bool(section)
            self.glyphs = dict(self.GLYPHS)
            self.timeout = 1800
        self.log = log
        self.omarchy = shutil.which("omarchy-notification-send") or shutil.which("omarchy")
        self.fallback = shutil.which("notify-send")
        self.last_id = 0

    def __call__(self, headline, description="", kind="armed", urgency="low"):
        if not self.enabled:
            return
        glyph = self.glyphs.get(kind, "")
        try:
            if self.omarchy:
                cmd = [self.omarchy]
                if cmd[0].endswith("/omarchy"):
                    cmd += ["notification", "send"]
                cmd += ["--app-name", APP, "-u", urgency, "-t", str(self.timeout), "-p"]
                if glyph:
                    cmd += ["-g", glyph]
                if self.last_id:
                    cmd += ["-r", str(self.last_id)]
                cmd += [headline, description] if description else [headline]
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=3).stdout
                new_id = "".join(c for c in out.strip() if c.isdigit())
                if new_id:
                    self.last_id = int(new_id)
            elif self.fallback:
                subprocess.Popen([self.fallback, "-a", APP, "-t", str(self.timeout),
                                  f"{glyph} {headline}".strip(), description],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as exc:  # noqa: BLE001 - a toast must never kill the daemon
            self.log(f"notify failed: {exc}")


class Backlight:
    """Keyboard backlight held on while the hotkeys are armed.

    The Dell firmware switches the light off stop_timeout (10s here) after
    the last keyboard or touchpad event -- and while you are playing on the
    pad there are none. While armed the daemon pins the LED's stop_timeout
    high ([backlight] pin, default 12h -- the most this firmware accepts;
    some models take 0 = truly never) and on disarm (or daemon stop)
    restores the value it found.

    The sysfs files are root-owned; `hd2-macro grant` chowns them to your
    user at boot. Without that, writes fail and this class just logs -- it
    must never take the daemon down over a light.
    """

    def __init__(self, cfg, log=print):
        section = cfg.get("backlight", {}) or {}
        self.enabled = bool(section.get("enabled", True))
        self.level = self._level(section.get("level"))
        self.pin = str(section.get("pin", "12h"))
        self.base = self._base(str(section.get("led", "dell::kbd_backlight")))
        self.saved: dict[str, str] | None = None
        self.log = log

    @staticmethod
    def _base(led: str) -> Path:
        if led.startswith("/"):
            return Path(led)
        if led:
            return Path("/sys/class/leds") / led
        # Empty [backlight] led: first *kbd_backlight* that can be pinned.
        # Shared chezmoi configs leave this blank so a G915 host and this
        # Dell can share one file; only the Dell LED has stop_timeout.
        root = Path("/sys/class/leds")
        try:
            for p in sorted(root.glob("*kbd_backlight")):
                if (p / "stop_timeout").is_file():
                    return p
        except OSError:
            pass
        return root

    @staticmethod
    def _level(value) -> int | None:
        if value is None:
            return None
        try:
            return max(0, int(value))
        except (TypeError, ValueError):
            return None

    @property
    def available(self) -> bool:
        return self.enabled and (self.base / "stop_timeout").is_file()

    def arm(self):
        """Pin the light on for an armed session. Idempotent, never raises."""
        if not self.available:
            return
        if self.saved is None:
            try:
                saved = {"stop_timeout": (self.base / "stop_timeout").read_text().strip()}
                if self.level is not None:
                    saved["brightness"] = (self.base / "brightness").read_text().strip()
            except OSError as exc:
                self.log(f"backlight: cannot read {self.base} ({exc.strerror})")
                return
        wrote = False
        try:
            (self.base / "stop_timeout").write_text(f"{self.pin}\n")
            wrote = True
            if self.level is not None:
                (self.base / "brightness").write_text(f"{self.level}\n")
        except OSError as exc:
            if self.saved is None and wrote:
                try:  # timeout pinned but the level failed: undo the pin
                    (self.base / "stop_timeout").write_text(saved["stop_timeout"] + "\n")
                except OSError:
                    pass
            self.log(f"backlight: cannot hold the light ({exc.strerror}) -- check "
                     f"`{APP} grant` for write access, or the firmware rejected "
                     f"pin={self.pin!r}")
            return
        if self.saved is None:
            self.saved = saved
            self.log(f"backlight held on (stop_timeout was {saved['stop_timeout']!r}; "
                     f"restored on disarm)")

    def disarm(self):
        """Restore whatever arm() found. Never raises."""
        if not self.saved:
            return
        saved, self.saved = self.saved, None
        try:
            (self.base / "stop_timeout").write_text(saved["stop_timeout"] + "\n")
            if self.level is not None and "brightness" in saved:
                (self.base / "brightness").write_text(saved["brightness"] + "\n")
            self.log(f"backlight released (stop_timeout back to {saved['stop_timeout']!r})")
        except OSError as exc:
            self.log(f"backlight restore failed: {exc.strerror}")

    def update(self, section):
        """Adopt a reloaded [backlight]; re-pin cleanly if it was held."""
        section = section or {}
        new_base = self._base(str(section.get("led", "dell::kbd_backlight")))
        new_level = self._level(section.get("level"))
        new_enabled = bool(section.get("enabled", True))
        new_pin = str(section.get("pin", "12h"))
        if (new_base == self.base and new_level == self.level
                and new_enabled == self.enabled and new_pin == self.pin):
            return
        was_held = self.saved is not None
        if was_held:
            self.disarm()  # restores against the old base before it changes
        self.base, self.level, self.enabled = new_base, new_level, new_enabled
        self.pin = new_pin
        if was_held and self.enabled:
            self.arm()


def keycode(name: str) -> int:
    n = name.upper()
    if not n.startswith("KEY_"):
        n = "KEY_" + n
    code = e.ecodes.get(n)
    if code is None:
        raise KeyError(f"unknown key {name!r} (evdev KEY_* name, e.g. F13, KP1)")
    return code if isinstance(code, int) else code[0]


def parse_hotkey(spec: str) -> tuple[int, frozenset[str]]:
    """'ALT+SHIFT+M' -> (KEY_M, {'ALT','SHIFT'});  '1' -> (KEY_1, set())"""
    parts = [p.strip().upper() for p in re.split(r"[+-](?!$)", spec.strip()) if p.strip()]
    if not parts:
        raise KeyError(f"empty hotkey {spec!r}")
    mods, key = set(), None
    for p in parts:
        canon = MOD_ALIASES.get(p, p)
        if canon in MODIFIERS:
            mods.add(canon)
        elif key is None:
            key = p
        else:
            raise KeyError(f"hotkey {spec!r} has more than one non-modifier key")
    if key is None:
        raise KeyError(f"hotkey {spec!r} is only modifiers")
    return keycode(key), frozenset(mods)


def show_hotkey(code: int, mods: frozenset[str]) -> str:
    name = e.KEY.get(code, code)
    name = name[0] if isinstance(name, list) else str(name)
    order = [m for m in ("CTRL", "ALT", "SHIFT", "SUPER") if m in mods]
    return "+".join(order + [name.removeprefix("KEY_")])


def padcode(name: str) -> int:
    n = name.upper()
    if n in BUTTONS:
        return BUTTONS[n]
    for prefix in ("BTN_", "KEY_"):
        code = e.ecodes.get(n if n.startswith(prefix) else prefix + n)
        if isinstance(code, int):
            return code
        if isinstance(code, list):
            return code[0]
    raise KeyError(f"unknown pad button {name!r}")


def find_keyboards(match: list[str], exclude: set[str]) -> list[InputDevice]:
    out = []
    for path in list_devices():
        if path in exclude:
            continue
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        keys = set(dev.capabilities().get(e.EV_KEY, []))
        if not {e.KEY_A, e.KEY_ENTER, e.KEY_SPACE} <= keys:
            dev.close()
            continue
        if match and not any(m.lower() in dev.name.lower() for m in match):
            dev.close()
            continue
        out.append(dev)
    return out


class Daemon:
    def __init__(self, cfg):
        self.cfg = cfg
        self.armed = True
        self.running = True
        self.pad = Pad(cfg)
        self.notify = Notifier(cfg, log=self.log)
        self.runner = Runner(self.pad, cfg, log=self.log)
        self.through = Passthrough(self.pad, cfg, on_button=self.handle, log=self.log)
        self.focus = HyprFocus(cfg, log=self.log)
        self.hotkeys, pad_hotkeys = self.compile_hotkeys(cfg)
        self.through.hotkeys = pad_hotkeys
        self.light = Backlight(cfg, log=self.log)
        self.light.arm()          # the daemon starts armed
        self.cfg_mtime = CONFIG.stat().st_mtime if CONFIG.exists() else 0.0
        self.mods: set[int] = set()
        self.sel = selectors.DefaultSelector()
        self.keyboards: dict[str, InputDevice] = {}
        self._last_fire: dict[str, float] = {}
        self.srv = None

    def log(self, msg):
        print(f"[{APP}] {msg}", flush=True)

    # ---- wiring ---------------------------------------------------------
    def rescan(self):
        if self.hotkeys:
            want = self.cfg.get("keyboards", {}).get("match", [])
            for dev in find_keyboards(want, {self.pad.path} | set(self.keyboards)):
                self.sel.register(dev, selectors.EVENT_READ, self._on_key)
                self.keyboards[dev.path] = dev
                self.log(f"keyboard: {dev.name}")
            self.resync_mods()
        if self.through.enabled:
            for dev in self.through.attach():
                self.sel.register(dev, selectors.EVENT_READ, self._on_pad)
        self.through.rescan_raw()

    def resync_mods(self):
        """Rebuild modifier state from what is actually held down, so a missed
        release event can't leave a phantom modifier wedging every hotkey."""
        held = set()
        for dev in list(self.keyboards.values()):
            try:
                held |= {c for c in dev.active_keys() if c in MOD_BY_CODE}
            except OSError:
                continue
        if held != self.mods:
            self.mods = held

    def compile_hotkeys(self, cfg) -> tuple[dict, dict]:
        """Resolve the [hotkeys] table. Raises if any name is unknown, so a
        typo can be rejected without disturbing what is already running."""
        keys, pad = {}, {}
        for name, target in cfg.get("hotkeys", {}).items():
            if name.lower().startswith("pad:"):
                pad[padcode(name[4:])] = target
            else:
                keys[parse_hotkey(name)] = target
        return keys, pad

    def maybe_reload(self):
        """Pick up edits to the config file without a restart."""
        try:
            mtime = CONFIG.stat().st_mtime
        except OSError:
            return
        if mtime == self.cfg_mtime:
            return
        self.cfg_mtime = mtime
        try:
            new = read_config()
            keys, pad = self.compile_hotkeys(new)
        except Exception as exc:  # noqa: BLE001 - bad edits must not kill the daemon
            msg = str(exc).split("\n")[0][:140]
            self.log(f"config reload REJECTED, keeping the running one: {msg}")
            self.notify("Config error", msg, kind="panic", urgency="normal")
            return

        if new.get("pad", {}) != self.cfg.get("pad", {}):
            self.log("note: [pad] changed, restart to recreate the virtual device")
        # Runner and others hold a reference to this dict, so update in place.
        self.cfg.clear()
        self.cfg.update(new)
        self.hotkeys = keys
        self.through.hotkeys = pad
        self.through.cfg = new.get("passthrough", {})
        self.through.configure()
        self.focus.match = [m.lower() for m in new.get("focus", {}).get("only_when", [])]
        self.notify = Notifier(new, log=self.log)
        self.light.update(new.get("backlight", {}))
        if self.armed:
            self.light.arm()
        self._last_fire.clear()
        total = len(keys) + len(pad)
        self.log(f"config reloaded: {total} hotkeys")
        self.notify("Config reloaded", f"{total} hotkeys",
                    kind="armed" if self.armed else "disarmed")

    def _on_key(self, dev):
        try:
            for ev in dev.read():
                if ev.type != e.EV_KEY:
                    continue
                if ev.code in MOD_BY_CODE:
                    if ev.value:
                        self.mods.add(ev.code)
                    else:
                        self.mods.discard(ev.code)
                    continue
                if ev.value != 1:  # keydown only, ignore autorepeat
                    continue
                active = frozenset(MOD_BY_CODE[c] for c in self.mods)
                target = self.hotkeys.get((ev.code, active))
                if target:
                    self.handle(target)
        except OSError as exc:
            if exc.errno in (errno.ENODEV, errno.EBADF):
                self.log(f"keyboard gone: {dev.name}")
                self.sel.unregister(dev)
                self.keyboards.pop(dev.path, None)
                self.mods.clear()
                dev.close()

    def _on_pad(self, dev):
        if not self.through.pump(dev):
            self.log(f"passthrough: {dev.name} disconnected")
            self.sel.unregister(dev)
            self.through.release(dev)

    def _on_focus(self, sock):
        if not self.focus.pump(sock):
            self.log("focus gate: Hyprland socket closed")
            self.sel.unregister(sock)
            self.focus.close()

    def _on_client(self, srv):
        try:
            conn, _ = srv.accept()
        except OSError:
            return
        with conn:
            conn.settimeout(2)
            try:
                reply = self.command(conn.recv(4096).decode().strip())
                conn.sendall((reply + "\n").encode())
            except OSError:
                pass

    # ---- commands -------------------------------------------------------
    def command(self, line: str) -> str:
        cmd, _, arg = line.partition(" ")
        cmd, arg = cmd.strip().lower(), arg.strip()
        if cmd == "status":
            src = ", ".join(self.through.names) or "none"
            raw = ','.join(r.node for r in self.through.raw.values() if r.alive) or 'none'
            gate = (f"focus={'PASS' if self.focus.allowed else 'BLOCKED'}"
                    f"({self.focus.cls or '-'}) " if self.focus.gating else "")
            light = (f" backlight={'held' if self.light.saved else 'auto'}"
                     if self.light.available else "")
            return (f"ok running armed={self.armed} pad={self.pad.path} "
                    f"js={self.pad.js} passthrough={src} raw={raw} {gate}busy={self.runner.busy}"
                    f"{light}")
        if cmd == "arm":
            self.armed = True
            self.light.arm()
            self.announce()
            return "ok armed"
        if cmd == "disarm":
            self.armed = False
            self.runner.stop()
            self.light.disarm()
            self.announce()
            return "ok disarmed"
        if cmd == "quit":
            self.running = False
            return "ok bye"
        if cmd == "reload":
            self.cfg_mtime = 0.0
            self.maybe_reload()
            return f"ok reloaded, {len(self.hotkeys) + len(self.through.hotkeys)} hotkeys"
        if cmd == "run":
            name, _, qs = arg.partition("?")
            over = {}
            for pair in qs.split("&") if qs else []:
                k, _, v = pair.partition("=")
                if k.strip():
                    over[k.strip()] = float(v) if v.replace(".", "", 1).isdigit() else v
            return self.handle(name.strip(), force=True, over=over)
        if cmd in ("toggle", "panic", "wake"):
            return self.handle(cmd)
        return f"err unknown command {line!r}"

    def announce(self):
        n = len([t for t in self.hotkeys.values() if t not in ("toggle", "panic", "wake")])
        if self.armed:
            self.notify("Macros armed", f"{n} hotkeys live", kind="armed")
        else:
            self.notify("Macros disarmed", "Keyboard back to normal", kind="disarmed")

    def handle(self, target: str, force=False, over: dict | None = None) -> str:
        if target == "toggle":
            self.armed = not self.armed
            if not self.armed:
                self.runner.stop()
                self.light.disarm()
            else:
                self.light.arm()
            self.announce()
            self.log("armed" if self.armed else "disarmed")
            return f"ok armed={self.armed}"
        if target == "panic":
            self.runner.stop()
            self.notify("Panic", "All buttons released", kind="panic", urgency="normal")
            return "ok neutral"
        if target == "wake":
            btn = self.cfg.get("pad", {}).get("wake_button", "LS")
            self.pad.set(btn, True)
            time.sleep(0.12)
            self.pad.set(btn, False)
            return "ok wake"
        if not self.armed and not force:
            return "err disarmed"
        if not force and not self.focus.allowed:
            return f"err window not focused ({self.focus.cls or 'none'})"
        # One physical keypress can surface on several event nodes -- a single
        # Logitech receiver here exposes three that all carry the digit row --
        # and each would otherwise re-trigger the macro.
        debounce = float(self.cfg.get("timing", {}).get("debounce_ms", 300)) / 1000.0
        now = time.monotonic()
        if not force and now - self._last_fire.get(target, 0.0) < debounce:
            self.log(f"debounced {target}")
            return f"err debounced {target}"
        self._last_fire[target] = now
        try:
            self.runner.fire(target, over=over)
        except Busy:
            self.log(f"busy, ignored {target}")
            return "err busy"
        except KeyError as exc:
            self.log(str(exc))
            return f"err {exc}"
        return f"ok {target}"

    # ---- loop -----------------------------------------------------------
    def serve(self):
        SOCKET.unlink(missing_ok=True)
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.srv.bind(str(SOCKET))
        self.srv.listen(8)
        self.srv.setblocking(False)
        os.chmod(SOCKET, 0o600)
        self.sel.register(self.srv, selectors.EVENT_READ, self._on_client)
        fsock = self.focus.connect()
        if fsock:
            self.sel.register(fsock, selectors.EVENT_READ, self._on_focus)
        self.rescan()
        self.log(f"pad {self.pad.path} ({self.pad.js})  "
                 f"hotkeys={len(self.hotkeys) + len(self.through.hotkeys)}")
        src = ", ".join(self.through.names)
        self.notify("Macro engine on",
                    f"Virtual pad ready" + (f" \u00b7 {src} merged in" if src else ""),
                    kind="armed")
        last = 0.0
        try:
            while self.running:
                self.through.tick()
                for key, _ in self.sel.select(timeout=self.through.timeout()):
                    key.data(key.fileobj)
                self.through.tick()
                if time.monotonic() - last > 3:
                    self.maybe_reload()
                    self.rescan()
                    last = time.monotonic()
        except KeyboardInterrupt:
            pass
        finally:
            self.shutdown()

    def shutdown(self):
        self.light.disarm()
        self.runner.stop()
        for dev in self.keyboards.values():
            dev.close()
        self.through.detach()
        self.focus.close()
        self.pad.close()
        if self.srv:
            self.srv.close()
        SOCKET.unlink(missing_ok=True)
        self.notify("Macro engine off", "Controller released", kind="disarmed")
        self.log("stopped")


