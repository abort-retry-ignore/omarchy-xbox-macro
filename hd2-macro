class Cancelled(Exception):
    pass


class Busy(Exception):
    """A macro is already running and on_busy is 'ignore'."""


def parse_code(s: str) -> list[str]:
    """'UDRLU' / 'up down right' / arrows -> ['UP','DOWN','RIGHT','LEFT','UP']"""
    out = []
    for tok in s.replace(",", " ").replace("-", " ").split():
        t = tok.upper()
        if t in HAT:
            out.append(t)
            continue
        for ch in t:
            if ch in DIRS:
                out.append(DIRS[ch])
            elif not ch.isspace():
                raise ValueError(f"bad direction {ch!r} in {s!r}")
    return out


class Runner:
    """Executes macro step lists on the pad, one at a time, cancellable."""

    def __init__(self, pad: Pad, cfg: dict, log=print):
        self.pad = pad
        self.cfg = cfg
        self.log = log
        self.cancel = threading.Event()
        self.thread: threading.Thread | None = None
        self.lock = threading.Lock()
        self._over: dict[str, float] = {}

    @property
    def speed(self) -> float:
        if "speed" in self._over:
            return float(self._over["speed"]) or 1.0
        return float(self.cfg.get("timing", {}).get("speed", 1.0)) or 1.0

    def t(self, key: str, default: int) -> float:
        """A [timing] value, in seconds, honouring per-run overrides."""
        raw = self._over.get(key, self.cfg.get("timing", {}).get(key, default))
        return (float(raw) / 1000.0) / self.speed

    def st(self, key: str, default: int) -> float:
        """A [stratagem] value, in seconds, honouring per-run overrides."""
        raw = self._over.get(key, self.cfg.get("stratagem", {}).get(key, default))
        return (float(raw) / 1000.0) / self.speed

    def ms(self, value: float) -> float:
        return float(value) / 1000.0 / self.speed

    def sleep(self, seconds: float):
        end = time.monotonic() + seconds
        while True:
            remaining = end - time.monotonic()
            if remaining <= 0:
                return
            if self.cancel.wait(min(remaining, 0.01)):
                raise Cancelled()

    @property
    def busy(self) -> bool:
        return bool(self.thread and self.thread.is_alive())

    def fire(self, name: str, over: dict | None = None):
        steps = self.resolve(name)
        with self.lock:
            if self.busy:
                if self.cfg.get("timing", {}).get("on_busy", "ignore") != "restart":
                    raise Busy(name)
                # Restarting mid-stratagem releases the hold button and presses
                # it again; HD2 reads that second press as a cancel and stows
                # the beacon. Only do it when explicitly asked for.
                self.cancel.set()
                self.thread.join(timeout=1.0)
            self.cancel = threading.Event()
            self._over = dict(over or {})
            self.thread = threading.Thread(target=self._run, args=(name, steps), daemon=True)
            self.thread.start()

    def stop(self):
        self.cancel.set()
        if self.thread:
            self.thread.join(timeout=1.0)
        self.pad.clear_macro()

    def resolve(self, name: str) -> list[str]:
        if ":" in name:
            kind, _, rest = name.partition(":")
        elif name in self.cfg.get("stratagems", {}):
            kind, rest = "strat", name
        else:
            kind, rest = "macro", name
        if kind in ("strat", "stratagem"):
            return [f"strat {self.cfg.get('stratagems', {}).get(rest, rest)}"]
        if kind == "macro":
            m = self.cfg.get("macros", {}).get(rest)
            if m is None:
                raise KeyError(f"no macro or stratagem named {rest!r}")
            return list(m["steps"]) if isinstance(m, dict) else list(m)
        if kind in ("press", "tap"):
            return [f"press {rest}"]
        if kind == "code":
            return [f"code {rest}"]
        raise KeyError(f"unknown target {name!r}")

    def _run(self, name, steps):
        extra = " ".join(f"{k}={v}" for k, v in self._over.items())
        self.log(f"run {name}" + (f"  [{extra}]" if extra else ""))
        try:
            for step in steps:
                self._step(step)
        except Cancelled:
            self.log(f"cancel {name}")
        except Exception as exc:  # noqa: BLE001
            self.log(f"error in {name}: {exc}")
        finally:
            self.pad.clear_macro()
            self._over = {}

    def _step(self, step: str):
        parts = str(step).split()
        if not parts:
            return
        op, args = parts[0].lower(), parts[1:]

        if op in ("press", "tap"):
            self.pad.set(args[0], True)
            self.sleep(self.ms(args[1]) if len(args) > 1 else self.t("press_ms", 80))
            self.pad.set(args[0], False)
            self.sleep(self.t("gap_ms", 60))
        elif op in ("down", "hold"):
            self.pad.set(args[0], True)
        elif op in ("up", "release"):
            self.pad.set(args[0], False)
        elif op in ("wait", "sleep", "delay"):
            self.sleep(self.ms(args[0]))
        elif op == "code":
            self._code(parse_code(" ".join(args)))
        elif op in ("strat", "stratagem"):
            self._stratagem(" ".join(args))
        elif op == "axis":
            self.pad.axis(args[0], int(args[1]))
            if len(args) > 2:
                self.sleep(self.ms(args[2]))
                self.pad.axis(args[0], 0)
        elif op == "stick":
            self.pad.stick(args[0], float(args[1]), float(args[2]))
            if len(args) > 3:
                self.sleep(self.ms(args[3]))
                self.pad.stick(args[0], 0, 0)
        elif op == "repeat":
            for _ in range(int(args[0])):
                self._step(" ".join(args[1:]))
        elif op == "neutral":
            self.pad.clear_macro()
        else:
            raise ValueError(f"unknown step {step!r}")

    def _code(self, dirs: list[str], trailing_gap: bool = True):
        press, gap = self.t("press_ms", 80), self.t("gap_ms", 60)
        for i, d in enumerate(dirs):
            self.pad.set(d, True)
            self.sleep(press)
            self.pad.set(d, False)
            if trailing_gap or i < len(dirs) - 1:
                self.sleep(gap)

    def _stratagem(self, code: str):
        s = self.cfg.get("stratagem", {})
        hold = self._over.get("hold_button", s.get("hold_button", "LB"))
        tap = s.get("hold_mode", "hold") == "tap"
        dirs = parse_code(self.cfg.get("stratagems", {}).get(code, code))
        self.pad.set(hold, True)
        if tap:
            self.sleep(self.t("press_ms", 80))
            self.pad.set(hold, False)
        try:
            self.sleep(self.st("pre_ms", 250))
            # No trailing gap: post_ms is measured from the final direction's
            # release, so the hold button comes off promptly. HD2 closes the
            # stratagem menu the moment a valid code lands, and a hold button
            # still down after that re-opens it -- releasing it then with an
            # empty code buffer stows the beacon you just drew.
            self._code(dirs, trailing_gap=False)
            self.sleep(self.st("post_ms", 80))
        finally:
            if not tap:
                self.pad.set(hold, False)
        throw = self._over.get("throw_button", s.get("throw_button"))
        if throw:
            self.sleep(self.st("throw_delay_ms", 300))
            self._step(f"press {throw} {s.get('throw_ms', 120)}")


